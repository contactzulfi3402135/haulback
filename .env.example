# Local/development example. Never commit a filled .env file.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
LEDGER_URL=http://localhost:8090/graphql
LEDGER_TOKEN=
REVIEW_PASSWORD=
[SECURITY_DATA]
NODE_ENV=development
PORT=8080

# Optional model providers. Leave blank for baseline:rules.
DRAFT_MODEL=baseline:rules
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OSS_BASE_URL=https://api.groq.com/openai/v1

# Go carrier-ledger stand-in only.
WORLD_SEED=20261025
